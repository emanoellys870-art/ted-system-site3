
---
import LayoutBase from '../layouts/LayoutBase.astro';
import { empresa } from './data/empresa.js';

const titulo = 'Início';
const descricao = `Bem-vindo à ${empresa.nome}. ${empresa.slogan}`;
---

<LayoutBase titulo={titulo} descricao={descricao}>
    <section>
        <h1>{empresa.slogan}</h1>
        <p>{empresa.missao}</p>
        <a href="/contato">Fale Conosco</a>
    </section>

    <section>
        <h2>Quem Atendemos</h2>
        <p>{empresa.publicoAlvo}</p>
    </section>
</LayoutBase>
